# ============================================
# Configuration globale — TP Niryo
# Copier ce fichier en .env et adapter les valeurs
# ============================================

# --- MQTT (Mosquitto) ---
MQTT_BROKER=192.168.1.3
MQTT_PORT=1883
MQTT_USER=nuc
MQTT_PASSWORD=nuc
MQTT_TOPIC=robot3/events

# --- Base de données MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=robot3
MYSQL_PASSWORD=robot3pass
MYSQL_DATABASE=robot3

# --- API Flask (Robot) ---
API_HOST=0.0.0.0
API_PORT=3000

# --- API Flask (mock robot) ---
MOCK_API_HOST=0.0.0.0
MOCK_API_PORT=3000